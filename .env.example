# 비워 두면 /api 요청을 Vite 또는 배포 프록시로 전달합니다.
VITE_API_BASE_URL=
# 로컬 개발 서버가 /api 요청을 전달할 백엔드 주소입니다.
VITE_API_PROXY_TARGET=http://localhost:8080
# 가입 신청 취소: DELETE, 본문 없음, 성공 204. 백엔드 경로가 다르면 이 값만 변경합니다.
# {teamId}는 선택한 팀 ID로 치환합니다. 실제 API 준비 전에는 서버 오류를 표시하며 신청 상태를 유지합니다.
VITE_TEAM_APPLICATION_CANCEL_PATH=/api/teams/{teamId}/applications/me
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
